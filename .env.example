# pixel2mqtt settings. Everything is optional: with network_mode: host and a broker on the same machine
# that allows anonymous clients, no settings are needed at all. Never commit your .env.

# Broker (default localhost:1883). Set MQTT_HOST=none to run the web editor without MQTT.
# MQTT_HOST=localhost
# MQTT_PORT=1883

# Only if your broker requires a login (recommended: a dedicated user for pixel2mqtt)
# MQTT_USER=pixel2mqtt
# MQTT_PASSWORD=change-me
# MQTT_PASSWORD_FILE=/run/secrets/mqtt_password   # alternative to MQTT_PASSWORD

# Web editor (default 8466)
# WEB_PORT=8466

# Displays to probe directly, comma separated, if the LAN broadcast can't reach them (e.g. bridge networking)
# PIXEL_HOSTS=192.168.1.50

# PIXEL2MQTT_BASE=pixel2mqtt          # base topic for the bridge and new displays
# HA_DISCOVERY_PREFIX=homeassistant
# SCAN_INTERVAL=120
# LOG_LEVEL=INFO
