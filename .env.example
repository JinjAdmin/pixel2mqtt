# Copy to .env and fill in. Never commit .env (it holds the MQTT password).
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=pixel2mqtt
MQTT_PASSWORD=change-me
# or: MQTT_PASSWORD_FILE=/run/secrets/mqtt_password

# Optional
# PIXEL2MQTT_BASE=pixel2mqtt          # base topic for the bridge and new displays
# HA_DISCOVERY_PREFIX=homeassistant
# WEB_PORT=8099
# PIXEL_HOSTS=192.168.1.50            # displays to probe directly (comma separated) if broadcast can't reach them
# SCAN_INTERVAL=120
# LOG_LEVEL=INFO
